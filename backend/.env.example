GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Use the *legacy anon* JWT key (starts with "eyJ..."), found under
# Settings > API > "Legacy anon, service_role API keys". supabase-py 2.7
# rejects the newer "sb_publishable_..." format.
SUPABASE_KEY=your_supabase_anon_jwt_here

# Comma-separated. Add your frontend's origin if it isn't the Vite default.
ALLOWED_ORIGINS=http://localhost:5173

# Applied to /chat/stream only. Per client IP, sliding window.
RATE_LIMIT_REQUESTS=3
RATE_LIMIT_WINDOW_SECONDS=60
